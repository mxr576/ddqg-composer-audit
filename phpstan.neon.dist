includes:
    - phpstan-baseline.neon
    - %rootDir%/../../composer/composer/phpstan/rules.neon
    - %rootDir%/../../phpstan/phpstan-deprecation-rules/rules.neon

parameters:
  level: max
  tipsOfTheDay: false
  reportUnmatchedIgnoredErrors: true
  treatPhpDocTypesAsCertain: false
  exceptions:
    check:
      missingCheckedExceptionInThrows: true
      tooWideThrowType: true
    uncheckedExceptionClasses:
      - 'InvalidArgumentException'
      - 'LogicException'
      - 'UnexpectedValueException'
      - 'PHPUnit\Framework\ExpectationFailedException'
      - 'PHPUnit\Framework\Exception'
      - 'PHPUnit\Framework\SkippedWithMessageException'
      - 'PHPUnit\Event\NoPreviousThrowableException'
    checkedExceptionClasses:
      - 'RuntimeException'
  paths:
    - src
    - tests
    - .php-cs-fixer.dist.php
    - phparkitect.php
  excludePaths:
    - */vendor/*
    - */tests/fixtures/e2e/web/*
    - */tests/fixtures/e2e/test.php
